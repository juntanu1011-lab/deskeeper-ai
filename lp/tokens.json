{
  "$schema": "Deskeeper LP (waitlist landing page) design tokens — independent from app tokens (../tokens/tokens.json). See lp/design.md for full spec and rationale.",
  "meta": {
    "scope": "landing page chrome only — never use for in-app UI or product screenshots",
    "confirmedAt": "2026-07-31",
    "stack": "Next.js on Vercel",
    "waitlistStorage": "Supabase (direct insert from a Next.js Route Handler)",
    "language": "en"
  },
  "color": {
    "base": "#042A2B",
    "panel": "#0C3A3C",
    "panel2": "#164A4C",
    "divider": "#1F585B",
    "border": "#3A8A8E",
    "ink": "#F5F1E6",
    "sub": "#5EB1BF",
    "bright": "#54F2F2",
    "cta": "#BB4430",
    "ctaBorder": "#D2573C",
    "ctaHover": "#A23A29",
    "warm": "#F3DFA2",
    "namedPalette": {
      "evergreen": "#042A2B",
      "pacificBlue": "#5EB1BF",
      "neonIce": "#54F2F2",
      "tomatoJam": "#BB4430",
      "vanillaCustard": "#F3DFA2"
    },
    "contrastVerified": {
      "ink_on_base": 13.57,
      "bright_on_base": 11.2,
      "warm_on_base": 11.59,
      "sub_on_base": 6.21,
      "sub_on_panel": 5.05,
      "ink_on_cta": 4.67,
      "cta_on_base": 2.9,
      "border_on_base": 3.8,
      "divider_on_base": 1.9
    }
  },
  "typography": {
    "fontFamily": {
      "display": "Bricolage Grotesque",
      "body": "Inter",
      "numeric": "Inter Tight"
    },
    "scale": {
      "display-xl": { "font": "display", "size": 56, "sizeSp": 36, "weight": 900, "lineHeight": 1.05, "letterSpacing": "-0.02em" },
      "display-l":  { "font": "display", "size": 36, "sizeSp": 28, "weight": 800, "lineHeight": 1.1,  "letterSpacing": "-0.015em" },
      "display-m":  { "font": "display", "size": 34, "sizeSp": 26, "weight": 800, "lineHeight": 1.15, "letterSpacing": "-0.01em" },
      "display-s":  { "font": "display", "size": 18, "sizeSp": 18, "weight": 800, "lineHeight": 1.3,  "letterSpacing": "0" },
      "body-l":     { "font": "body", "size": 18,   "sizeSp": 16, "weight": 500, "lineHeight": 1.6 },
      "body-m":     { "font": "body", "size": 16,   "sizeSp": 15, "weight": 500, "lineHeight": 1.7 },
      "body-s":     { "font": "body", "size": 14.5, "sizeSp": 14, "weight": 500, "lineHeight": 1.65 },
      "body-xs":    { "font": "body", "size": 12.5, "sizeSp": 12, "weight": 500, "lineHeight": 1.5 },
      "label":      { "font": "numeric", "size": 13, "sizeSp": 12, "weight": 900, "lineHeight": 1.2, "letterSpacing": "0.08em", "textTransform": "uppercase" },
      "badge":      { "font": "body", "size": 12.5, "sizeSp": 12, "weight": 700, "lineHeight": 1.2, "letterSpacing": "0.06em", "textTransform": "uppercase" }
    },
    "numericFeatures": { "fontVariantNumeric": "tabular-nums" },
    "source": "Google Fonts via next/font/google"
  },
  "spacing": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128],
  "layout": {
    "contentMaxWidth": 1080,
    "pageGutter": 24,
    "sectionPadding": { "desktop": 96, "mobile": 64 },
    "breakpoints": { "sm": 520, "md": 900 }
  },
  "radius": { "s": 12, "m": 20, "l": 28, "x": 40, "pill": 999 },
  "effects": {
    "glowHover": "0 0 0 1px #54F2F2, 0 0 24px -6px rgba(84,242,242,.45)",
    "glowFocus": "0 0 0 3px rgba(84,242,242,.35)",
    "shadowCard": "0 30px 70px -30px rgba(0,0,0,.7)",
    "glowHeroOpacity": 0.08
  },
  "motion": {
    "scrollReveal": { "durationMs": 500, "easing": "cubic-bezier(0.16, 1, 0.3, 1)", "translateYFromPx": 16, "staggerMs": 70 },
    "hover": { "durationMs": 200, "easing": "ease-out" },
    "buttonPress": { "durationMs": 120, "easing": "ease-out" },
    "accordion": { "durationMs": 300, "easing": "ease" },
    "respectsReducedMotion": true
  },
  "mascot": {
    "note": "Uses the app's own mascot colors — never recolor with the LP palette.",
    "furMain": "#C9A574",
    "belly": "#EDE0C8",
    "eyeMask": "#3D2C22",
    "nose": "#1A1512",
    "pawsAndTailTip": "#4A3527",
    "maxAppearancesPerPage": 4
  },
  "productImageryOverride": {
    "note": "Output-video previews and app screenshots MUST use the app's color system, not the LP palette.",
    "base": "#0A0C10",
    "warm": "#FFB02E",
    "warm2": "#FF7A45",
    "ink": "#EDEFF3"
  },
  "rules": {
    "ctaBorderRequired": "Tomato Jam #BB4430 has only 2.90 contrast against the base — every primary CTA button MUST carry a 1px #D2573C border so its boundary is visible. Never ship a borderless Tomato Jam button.",
    "ctaUsage": "Tomato Jam is for primary CTA buttons only. Never use it as a text color on the dark base (2.90 = unreadable).",
    "brightUsage": "Neon Ice is for glow/interactive states (hover, focus, highlight lines) — avoid large flat fills.",
    "warmUsage": "Vanilla Custard is the rarest color — 3-4 uses per page max (badges, quote marks, single emphasized words).",
    "borderVsDivider": "Use `border` (#3A8A8E, 3.80) for meaningful boundaries like form inputs. Use `divider` (#1F585B, 1.90) only for decorative rules.",
    "noFakeSocialProof": "Do not display signup counters, review counts, or press mentions — there are none yet.",
    "noAgeDisclosure": "Do not mention the founder's age anywhere in LP copy. This is intentionally separate from the X/build-in-public channel, which does use it."
  }
}
