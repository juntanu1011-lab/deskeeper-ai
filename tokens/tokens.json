{
  "$schema": "Deskeeper design tokens — direction D (Keeper). See design/design.md for rationale.",
  "meta": {
    "direction": "D. Keeper",
    "confirmedAt": "2026-07-31"
  },
  "color": {
    "base": "#0A0C10",
    "panel": "#14171D",
    "panel2": "#1B1F27",
    "line": "#232833",
    "ink": "#EDEFF3",
    "sub": "#7A828F",
    "dim": "#454C58",
    "cold": "#7C93A8",
    "warm": "#FFB02E",
    "warm2": "#FF7A45",
    "warmGradient": ["#FFB02E", "#FF7A45"],
    "warn": "#D8654E"
  },
  "mascot": {
    "fixed": {
      "furMain": "#C9A574",
      "belly": "#EDE0C8",
      "eyeMask": "#3D2C22",
      "nose": "#1A1512",
      "pawsAndTailTip": "#4A3527",
      "earInner": "#4A3527"
    },
    "variable": {
      "eyeGlowCold": "#7C93A8",
      "eyeGlowWarm": "#FFB02E",
      "eyeGlowWarmDeep": "#FF7A45",
      "rimLightSyncsWithEyeGlow": true
    },
    "renderStyle": {
      "primary": "dimensional-soft-3d",
      "smallSizeFallback": "flat-silhouette",
      "smallSizeThresholdPx": 24,
      "rule": "flat silhouette must match dimensional silhouette exactly"
    }
  },
  "typography": {
    "fontFamily": {
      "numeric": "Inter Tight",
      "ui": "Inter",
      "ja": "Noto Sans JP"
    },
    "weight": {
      "scoreNumberLarge": 900,
      "heading": 800,
      "body": 400,
      "bodyEmphasis": 700
    },
    "numericFeatures": {
      "fontVariantNumeric": "tabular-nums",
      "letterSpacingLarge": "-0.03em"
    },
    "source": "expo-google-fonts"
  },
  "spacing": [4, 8, 12, 16, 24, 32, 48],
  "radius": {
    "s": 8,
    "m": 14,
    "l": 20,
    "x": 28,
    "pill": 999
  },
  "motion": {
    "coldToWarmReversal": {
      "durationMs": 640,
      "easing": "cubic-bezier(0.16, 1, 0.3, 1)"
    },
    "uiTransition": {
      "durationMs": 200,
      "easing": "ease-out"
    },
    "buttonPress": {
      "durationMs": 120,
      "easing": "ease-out"
    }
  },
  "scorecard": {
    "note": "Layout is fixed for both free and Pro tiers — only theme/BGM/format vary by plan (see 設計/03_課金設計.md). Position, color, and mascot mark must stay constant for feed recognizability at ~58px.",
    "elements": ["mascotMarkSmall", "brandWordmark", "scoreNumber", "warmGradientBar", "durationAndSubject"]
  }
}
